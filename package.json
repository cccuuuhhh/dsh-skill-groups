{
  "name": "dsh-skill-groups",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Group skills and toggle any combination, with drag-to-reorder and per-group catalog cost preview.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cccuuuhhh/dsh-skill-groups.git"
  },
  "homepage": "https://github.com/cccuuuhhh/dsh-skill-groups#readme",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
